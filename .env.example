# ═══════════════════════════════════════════════════════════════
# ربات کاندیداتوری هوشمند — نمونه فایل محیطی
# ═══════════════════════════════════════════════════════════════
# این فایل را به .env کپی کنید و مقادیر واقعی را جایگزین کنید.
# ⚠️  فایل .env را هرگز در گیت کامیت نکنید.
# ═══════════════════════════════════════════════════════════════

# ─── تلگرام ───
BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER

# ─── حل خطای "Bot not initialized" در serverless ───
# ۱) این دستور را اجرا کنید (با توکن واقعی):
#    curl https://api.telegram.org/bot<TOKEN>/getMe
# ۲) خروجی "result" را کپی کنید (به صورت یک خط JSON):
BOT_INFO={"id":0000000000,"is_bot":true,"first_name":"نام بات","username":"your_bot_username","can_join_groups":true,"can_read_all_group_messages":false,"supports_inline_queries":false}

# ─── Appwrite ───
# ⚠️  endpoint بسته به منطقه‌ی project متفاوت است:
#    Frankfurt:  https://fra.cloud.appwrite.io/v1
#    NYC:        https://nyc.cloud.appwrite.io/v1
#    Sydney:     https://syd.cloud.appwrite.io/v1
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id_here
APPWRITE_API_KEY=your_api_key_with_databases_full_access

# ─── شناسه‌های دیتابیس (پیش‌فرض‌ها معمولاً کافی است) ───
DATABASE_ID=kandidatory_db
COLLECTION_USERS=users
COLLECTION_CONSULT=consultations
COLLECTION_LEADS=leads
