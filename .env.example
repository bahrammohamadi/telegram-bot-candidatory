# ═══════════════════════════════════════════════════════════════
# ربات کاندیداتوری هوشمند — نمونه فایل محیطی
# ═══════════════════════════════════════════════════════════════
# این فایل را به .env کپی کنید و مقادیر واقعی را جایگزین کنید.
# ⚠️  فایل .env را هرگز در گیت کامیت نکنید.
# ═══════════════════════════════════════════════════════════════

# ─── تلگرام ───
BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER

# ─── پنل ادمین ───
# ۱) رمز ورود به پنل ادمین. اگر این مقدار خالی باشد، پنل بدون رمز باز می‌شود.
#    هر بار که ادمین /admin بزند و جلسه‌اش منقضی شده باشد، این رمز را می‌خواهد.
ADMIN_PASSWORD=یک_رمز_قوی_اینجا_بگذارید
# ۲) مدت اعتبار جلسه‌ی ادمین پس از زدن رمز (به دقیقه). پیش‌فرض: ۳۰
ADMIN_SESSION_MINUTES=30
# ۳) (اختیاری) آیدی عددی تلگرام ادمین‌های اولیه (bootstrap)، جدا شده با کاما.
#    این افراد همیشه ادمین محسوب می‌شوند حتی اگر role در دیتابیس admin نباشد.
#    آیدی عددی خود را می‌توانید از ربات @userinfobot بگیرید.
#    منبع اصلی ادمین‌ها همان ستون role=admin در دیتابیس Appwrite است؛
#    این متغیر فقط برای اطمینان/بازیابی دسترسی است.
ADMIN_IDS=

# ─── حل خطای "Bot not initialized" در serverless ───
# ۱) این دستور را اجرا کنید (با توکن واقعی):
#    curl https://api.telegram.org/bot<TOKEN>/getMe
# ۲) خروجی "result" را کپی کنید (به صورت یک خط JSON):
BOT_INFO={"id":0000000000,"is_bot":true,"first_name":"نام بات","username":"your_bot_username","can_join_groups":true,"can_read_all_group_messages":false,"supports_inline_queries":false}

# ─── Appwrite ───
# ⚠️  endpoint بسته به منطقه‌ی project متفاوت است:
#    Frankfurt:  https://fra.cloud.appwrite.io/v1
#    NYC:        https://nyc.cloud.appwrite.io/v1
#    Sydney:     https://syd.cloud.appwrite.io/v1
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id_here
APPWRITE_API_KEY=your_api_key_with_databases_full_access

# ─── شناسه‌های دیتابیس (پیش‌فرض‌ها معمولاً کافی است) ───
DATABASE_ID=kandidatory_db
COLLECTION_USERS=users
COLLECTION_CONSULT=consultations
COLLECTION_LEADS=leads

# ═══════════════════════════════════════════════════════════════
# ─── هوش مصنوعی (تولید متن) ───
# ═══════════════════════════════════════════════════════════════
# انتخاب سرویس: gemini (رایگان، پیش‌فرض) یا openai (یا سرویس سازگار با OpenAI)
AI_PROVIDER=gemini

# ── گزینه ۱: Google Gemini (رایگان — توصیه‌شده) ──
# کلید را از https://aistudio.google.com/apikey بگیرید (رایگان):
GEMINI_API_KEY=your_gemini_api_key_here
# مدل پیش‌فرض flash-lite است چون بیشترین سقف روزانه‌ی رایگان را دارد (~۱۰۰۰ درخواست/روز)
GEMINI_MODEL=gemini-2.5-flash-lite

# ── گزینه ۲: OpenAI یا سرویس سازگار (برای AI_PROVIDER=openai) ──
# OPENAI_API_KEY=your_openai_or_compatible_key
# برای سرویس‌های واسط/ایرانیِ سازگار با OpenAI، BASE_URL را تغییر دهید:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ── تنظیمات عمومی AI (اختیاری) ──
# AI_TIMEOUT_MS=30000
# AI_MAX_TOKENS=1200
# تلاش مجدد خودکار هنگام خطای موقت (سقف نرخ ۴۲۹ یا خطای سرور):
# AI_MAX_RETRIES=2
# AI_RETRY_DELAY_MS=1500
