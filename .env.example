# .env.example — نسخه اصلاح‌شده ۱۴۰۴/۱۲/۰۸
# ═══════════════════════════════════════════════════════════════
# ✅ فیکس: توکن نمونه (نه واقعی)
# ✅ فیکس: نام‌های متغیرها همخوان با Appwrite Console
# ═══════════════════════════════════════════════════════════════

# ─── Telegram Bot ───
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz123456789
BOT_INFO={"id":1234567890,"is_bot":true,"first_name":"نمونه ربات","username":"example_bot"}

# ─── Appwrite ───
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=fra-699d6797003d63f0fd8c
APPWRITE_API_KEY=your_api_key_here

# ─── Database (نام‌های Appwrite Console) ───
DATABASE_ID=699d6d5a0038857d3279
COLLECTION_USERS=users
COLLECTION_CONSULT=consultations
COLLECTION_LEADS=leads_status

# ─── Admin ───
ADMIN_IDS=123456789,987654321
